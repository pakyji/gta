DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- AI (optional — Pollinations works with NO key) -------------------------
# Priority: GROQ > OPENAI > OPENROUTER > GEMINI > TOGETHER > FIREWORKS >
#           DEEPSEEK > MISTRAL > HUGGINGFACE > POLLINATIONS (free) > local
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# HF_TOKEN=
# POLLINATIONS_API_KEY=
# POLLINATIONS_MODEL=openai
# AI_PROVIDER=pollinations
# AI_MODEL=

# NEWS_FEED_URL=
# NEWS_REFRESH_SECRET=      # 16+ chars. Needed for POST /api/news/refresh (Authorization: Bearer <secret>)
# APP_URL=https://your-domain.example

# ---- Fun APIs (optional) ----------------------------------------------------
# CAT_API_KEY=          # TheCatAPI key (public works without it)
# THECATAPI_KEY=        # alias
# Weather uses Open-Meteo (no key). Dogs use Dog CEO (no key).
